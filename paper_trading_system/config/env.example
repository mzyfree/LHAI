# Copy this file to config/env.local and edit paths for the current machine.

# Runtime
PYTHON_BIN=python
QRUN_BIN=qrun
DEVICE=auto

# Qlib can be installed by pip:
#   pip install pyqlib
# If you need to use a local Qlib source tree, set QLIB_SRC=/path/to/qlib.
# Otherwise keep it empty.
QLIB_SRC=
QLIB_PROVIDER_URI=/root/autodl-tmp/llhh/paper_trading_system/data/current
MLRUNS_DIR=/root/autodl-tmp/llhh/src/mlruns

# Data update.
DATA_ROOT=/root/autodl-tmp/llhh/paper_trading_system/data
DATA_RELEASES_DIR=/root/autodl-tmp/llhh/paper_trading_system/data/releases
DATA_CURRENT_LINK=/root/autodl-tmp/llhh/paper_trading_system/data/current
DATA_DOWNLOAD_URL=https://github.com/chenditc/investment_data/releases/latest/download/qlib_bin.tar.gz
DATA_KEEP_RELEASES=2
DATA_ARCHIVES_DIR=/root/autodl-tmp/llhh/paper_trading_system/data/archives
DATA_KEEP_ARCHIVES=5
# auto = previous local market day, skipping weekends and DATA_MARKET_HOLIDAYS.
# Add exchange holidays here when an upstream release tag is newer than the actual A-share calendar.
DATA_REQUIRED_DATE=auto
DATA_MARKET_HOLIDAYS=2026-06-19
# Patch the downloaded GitHub release with fresher DoltHub rows when release uploads lag.
DATA_DOLTHUB_PATCH=1
DATA_DOLTHUB_PATCH_STRICT=0
DATA_DOLTHUB_API_URL=https://www.dolthub.com/api/v1alpha1/chenditc/investment_data/master

# Portable paper-trading directory.
# If this folder is copied to another machine, only update PAPER_HOME.
PAPER_HOME=/root/autodl-tmp/llhh/paper_trading_system
PAPER_STATE_DIR=/root/autodl-tmp/llhh/paper_trading_system/state
PAPER_REPORT_DIR=/root/autodl-tmp/llhh/paper_trading_system/reports
PAPER_LOG_DIR=/root/autodl-tmp/llhh/paper_trading_system/logs

# Strategy
CAPITAL=100000
TOPK=7
N_DROP=1
WEIGHTS=3,1,1
FILTER_MODE=jq_filter
FILTER_ST=1
FILTER_PAUSED=1
LOT_SIZE=100
RESERVE_CASH_PCT=0.02
# Budget modes:
# - capital_pool: default simulation mode; ignore account cash and plan from configured capital.
# - available_cash: live/manual mode; plan from current account cash.
# - capital_pool_reserved / available_cash_reserved: keep RESERVE_CASH_PCT aside.
BUY_BUDGET_MODE=capital_pool
MAX_POSITION_PCT=0.12
MIN_PRICE=5
MAX_PRICE=80
MIN_AMOUNT=20000000
LOOKBACK=20
ALLOW_ONE_LOT_OVER_TARGET=1

# A-share cost estimate.
BUY_COST_RATE=0.0003
SELL_COST_RATE=0.0008
MIN_COST=5

# Prediction inputs. Prefer FUSED_PRED if available; otherwise set three legs.
FUSED_PRED=
PRED_A=/root/autodl-tmp/llhh/preds_smallcap/csi1000_recovered/xgb_csi1000_long_prod2026.pkl
PRED_B=/root/autodl-tmp/llhh/preds_smallcap/csi1000_recovered/doubleensemble_csi1000_short_prod2026.pkl
PRED_C=/root/autodl-tmp/llhh/preds_smallcap/csi1000_recovered/catboost_csi1000_long_prod2026.pkl

# Training configs and outputs.
# The train script can run on CPU or GPU by changing DEVICE.
XGB_SHORT_NAME=xgboost_short_2026
XGB_LONG_NAME=xgboost_long_2026
ADARNN_SHORT_NAME=adarnn_short_2026

XGB_SHORT_CONFIG=/root/autodl-tmp/llhh/src/configs/reference_rolling_xgb2_adarnn/workflow_config_xgboost_short_2026.yaml
XGB_LONG_CONFIG=/root/autodl-tmp/llhh/src/configs/reference_rolling_xgb2_adarnn/workflow_config_xgboost_long_2026.yaml
ADARNN_SHORT_CONFIG=/root/autodl-tmp/llhh/src/configs/reference_rolling_xgb2_adarnn/workflow_config_adarnn_short_2026.yaml

XGB_SHORT_PRED=/root/autodl-tmp/llhh/preds/xgboost_short_2026_2026_ytd_prod_like.pkl
XGB_LONG_PRED=/root/autodl-tmp/llhh/preds/xgboost_long_2026_2026_ytd_prod_like.pkl
ADARNN_SHORT_PRED=/root/autodl-tmp/llhh/preds/adarnn_short_2026_2026_ytd_prod_like.pkl

# Set FORCE_TRAIN=1 to retrain even when the target pred already exists.
FORCE_TRAIN=0
