# Copy to config/env.local and edit local paths.

# Runtime
PYTHON_BIN=python3
LHAI_HOME=/Users/Dylan.Min/Documents/Code/learn/LHAI
PAPER_ENGINE_HOME=/Users/Dylan.Min/Documents/Code/learn/LHAI/paper_trading_system

# Local Qlib data. This must be a readable Qlib daily cn_data directory.
# The checked local release currently reaches 2026-05-18.
QLIB_PROVIDER_URI=/Users/Dylan.Min/Documents/Code/learn/LHAI/paper_trading_system/data/current

# Local execution state.
OPS_HOME=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops
PAPER_STATE_DIR=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops/state/live_10w_main
PAPER_REPORT_DIR=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops/reports/live_10w_main
PAPER_LOG_DIR=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops/logs
LOCAL_PRED_DIR=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops/preds/csi1000
LIVE_TASK_DIR=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops/live_tasks
LIVE_SUBMISSION_DIR=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops/live_submissions
LIVE_FILL_DIR=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops/live_fills
DAILY_SNAPSHOT_DIR=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops/daily_snapshots

# WeChat report push. Recommended for normal WeChat: pushplus or serverchan.
# Set WECHAT_REPORT_MODE=console to print only.
WECHAT_REPORT_MODE=pushplus
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
SERVERCHAN_SENDKEY=
BOTTALK_SENDKEY=
WECHAT_REPORT_WEBHOOK_URL=

# GPU sync endpoints.
GPU_SSH=root@connect.westc.seetacloud.com
GPU_SSH_PORT=37172
GPU_PRED_DIR=/root/autodl-tmp/llhh/preds_smallcap/csi1000_recovered
GPU_QLIB_PROVIDER_URI=/root/autodl-tmp/llhh/reference_cn_data/cn_data

# Main strategy prediction inputs.
PRED_A=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops/preds/csi1000/xgb_csi1000_long_prod2026.pkl
PRED_B=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops/preds/csi1000/doubleensemble_csi1000_short_prod2026.pkl
PRED_C=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops/preds/csi1000/catboost_csi1000_long_prod2026.pkl
FUSED_PRED=

# Prediction generation.
# sync: pull latest prediction pkls from GPU.
# command: run PREDICTION_CMD to produce/update PRED_A/PRED_B/PRED_C locally.
# skip: only validate existing prediction pkls.
PREDICTION_MODE=command
PREDICTION_CMD="${PYTHON_BIN} ${OPS_HOME}/bin/predict_from_model_package.py --provider-uri ${QLIB_PROVIDER_URI} --package ${OPS_HOME}/model_packages/csi1000_main_model_packages_20260522.tar.gz --extract-dir ${OPS_HOME}/model_packages/extracted --output-dir ${LOCAL_PRED_DIR}"

# Strategy.
CAPITAL=100000
TOPK=7
N_DROP=1
WEIGHTS=3,1,1
FILTER_MODE=jq_filter
MIN_AMOUNT=20000000
MIN_PRICE=5
MAX_PRICE=80
LOOKBACK=20
BUY_SCAN_TOPK=150

# Execution assumptions.
LOT_SIZE=100
RESERVE_CASH_PCT=0.02
MAX_POSITION_PCT=0.12
ALLOW_ONE_LOT_OVER_TARGET=1
BUY_COST_RATE=0.0003
SELL_COST_RATE=0.0008
MIN_COST=5

# Live execution bridge. Keep manual/disabled until a broker adapter is configured.
# manual: write an operator ticket only.
# hook: call LIVE_ORDER_HOOK with task/submission paths when LIVE_TRADING_ENABLED=1.
LIVE_BROKER_MODE=manual
LIVE_TRADING_ENABLED=0
LIVE_ORDER_HOOK=/Users/Dylan.Min/Documents/Code/learn/LHAI/local_trade_ops/bin/qmt_order_adapter.py

# QMT / miniQMT adapter. Fill these after xtquant is installed locally.
QMT_CLIENT_PATH=
QMT_ACCOUNT_ID=
QMT_ACCOUNT_TYPE=STOCK
QMT_SESSION_ID=1001
QMT_ORDER_TYPE=LATEST_PRICE
QMT_PRICE_TYPE=MARKET
QMT_STRATEGY_NAME=llhh_csi1000_main
QMT_ORDER_REMARK=local_trade_ops

# Realtime quote helper. Used only as a decision aid; orders are still manual.
TUSHARE_TOKEN=
REALTIME_QUOTE_PROVIDER=tushare_rt_k
